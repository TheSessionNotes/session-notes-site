---
// Usage: <SpotifyEmbed id="3QVrLwwUkt3uTn0SSWH4xI" type="track" />
const { id, type = 'track', title = 'Spotify player' } = Astro.props;
---
<div class="sp-embed">
  <iframe
    src={`https://open.spotify.com/embed/${type}/${id}?utm_source=generator`}
    title={title}
    width="100%" height="152"
    frameborder="0"
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"
    allowfullscreen
  ></iframe>
</div>
<style>
  .sp-embed{margin:32px 0}
  .sp-embed iframe{border-radius:12px;display:block}
</style>
