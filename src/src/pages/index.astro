---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const all = (await getCollection('interviews')).sort((a, b) => b.data.number - a.data.number);
const featured = all.find(i => i.data.featured) ?? all[0];
const rest = all.filter(i => i.id !== featured?.id);
const pad = (n) => String(n).padStart(2, '0');
---
<Base title="The Session Notes" current="home">
  <div class="wrap">
    {featured && (
      <section class="hero-a">
        <div class="hero-a-top">
          <div class="eyb">Interview {pad(featured.data.number)} / {featured.data.role}</div>
          <h1><a href={`/interviews/${featured.id}`}>{featured.data.title}</a></h1>
        </div>
        <div class="hero-a-grid">
          <div class="hero-a-left">
            {featured.data.heroImage && (
              <a href={`/interviews/${featured.id}`} class="hero-photo">
                <Image src={featured.data.heroImage} alt={featured.data.heroAlt ?? featured.data.title} widths={[500, 800, 1100]} sizes="(max-width: 820px) 100vw, 640px" />
              </a>
            )}
            <p class="sub">{featured.data.intro}</p>
            <div class="hero-meta">RECORDED {featured.data.date.toUpperCase()} — <a href={`/interviews/${featured.id}`}>READ THE INTERVIEW →</a></div>
          </div>
          {featured.data.pullquote && (
            <div class="qcard">
              <div class="n">{pad(featured.data.number)}</div>
              <blockquote>{featured.data.pullquote}</blockquote>
              {featured.data.pullquoteBy && <cite>{featured.data.pullquoteBy}</cite>}
            </div>
          )}
        </div>
      </section>
    )}

    <section class="arch">
      <div class="arch-h">The Archive — {all.length} {all.length === 1 ? 'interview' : 'interviews'}</div>
      {rest.map(i => (
        <a class="row" href={`/interviews/${i.id}`}>
          <div class="num">{pad(i.data.number)}</div>
          <div class="ti">{i.data.title}</div>
          <div class="rl">{i.data.role}</div>
        </a>
      ))}
      <a class="row next" href="mailto:thesessionnotes@outlook.com">
        <div class="num">→</div>
        <div class="ti">Know someone worth interviewing?</div>
        <div class="rl">Get in touch</div>
      </a>
    </section>
  </div>
</Base>
