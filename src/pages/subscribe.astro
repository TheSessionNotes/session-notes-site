---
import Base from '../layouts/Base.astro';
---
<Base title="Subscribe — The Session Notes" current="subscribe">
  <div class="wrap">
    <section class="subscribe" style="border-top:none;margin-top:0;padding-top:52px">
      <div class="inner">
        <div class="eyb">The mailing list</div>
        <h2>A new interview every two weeks.</h2>
        <p>No spam, no filler — just the next conversation, sent to your inbox the morning it goes up.</p>
        <!--
          TO MAKE THIS REAL: make a free Buttondown account, then replace
          YOUR_USERNAME below with your Buttondown username (or paste their embed).
        -->
        <form class="form" action="https://buttondown.com/api/emails/embed-subscribe/YOUR_USERNAME" method="post" target="popupwindow">
          <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" required />
          <button type="submit">Subscribe</button>
        </form>
      </div>
    </section>
  </div>
</Base>
