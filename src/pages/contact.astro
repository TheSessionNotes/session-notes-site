---
import Base from '../layouts/Base.astro';
---
<Base title="Contact — The Session Notes" current="contact">
  <div class="wrap">
    <section class="about">
      <div class="kicker">Contact</div>
      <h1>Know someone worth interviewing?</h1>
      <p>If you work in music and would be up for a conversation, or you know someone whose story should be told, send a note. Artists, producers, engineers, teachers, managers, bookers, label folks — anyone doing the real work.</p>

      <div class="form-status" data-fs-success></div>
      <div class="form-status form-status--error" data-fs-error></div>

      <form id="contact-form" class="contact-form">
        <label>
          <span>Your name</span>
          <input type="text" id="name" name="name" data-fs-field required />
          <span class="field-error" data-fs-error="name"></span>
        </label>

        <label>
          <span>Email</span>
          <input type="email" id="email" name="email" data-fs-field required />
          <span class="field-error" data-fs-error="email"></span>
        </label>

        <label>
          <span>Who are you / who should I talk to?</span>
          <input type="text" id="role" name="role" data-fs-field placeholder="e.g. drummer, manager, or a person to introduce" />
          <span class="field-error" data-fs-error="role"></span>
        </label>

        <label>
          <span>Message</span>
          <textarea id="message" name="message" rows="6" data-fs-field required></textarea>
          <span class="field-error" data-fs-error="message"></span>
        </label>

        <button type="submit" data-fs-submit-btn>Send message</button>
      </form>

      <p class="contact-alt">Prefer email? Reach out directly at <a class="link" href="mailto:thesessionnotes@outlook.com">thesessionnotes@outlook.com</a>.</p>

      <a class="back" href="/">← Back home</a>
    </section>
  </div>

  <script is:inline>
    window.formspree = window.formspree || function () { (formspree.q = formspree.q || []).push(arguments); };
    formspree('initForm', { formElement: '#contact-form', formId: 'xwlelbnp' });
  </script>
  <script is:inline src="https://unpkg.com/@formspree/ajax@1" defer></script>
</Base>
