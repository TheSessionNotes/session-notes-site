---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Newest first. The lead story is the one marked featured: true, or the newest if none is.
const all = (await getCollection('interviews')).sort((a, b) => b.data.number - a.data.number);
const featured = all.find((i) => i.data.featured) ?? all[0];
const others = all.filter((i) => i.id !== featured?.id);

// How the rest of the collection is split across the page.
const rail = others.slice(0, 3);     // photo rail beside the lead story
const more = others.slice(3, 7);     // photo card row
const archive = others.slice(7);     // compact numbered rows

// Up to three pull quotes, starting with the lead story.
const voices = [featured, ...others].filter((i) => i?.data.pullquote).slice(0, 3);

const pad = (n) => String(n).padStart(2, '0');
const href = (i) => `/interviews/${i.id}`;

// Prefer the portrait card image for small tiles, fall back to the landscape hero.
const thumb = (i) =>
  i.data.cardImage
    ? { src: i.data.cardImage, alt: i.data.cardAlt ?? i.data.title }
    : i.data.heroImage
      ? { src: i.data.heroImage, alt: i.data.heroAlt ?? i.data.title }
      : null;

// The lead story prefers the landscape hero, falling back to the card image.
const leadImg = featured
  ? featured.data.heroImage
    ? { src: featured.data.heroImage, alt: featured.data.heroAlt ?? featured.data.title }
    : thumb(featured)
  : null;

const leadLabel = featured?.data.featured ? 'Featured' : 'Latest';
const railLabel = featured && others[0] && others[0].data.number > featured.data.number ? 'Latest' : 'Also new';
---
<Base
  title="The Session Notes: interviews with the people who make music work"
  current="home"
  description="An interview publication about the working music world. Conversations with artists, drummers, guitarists, engineers, and industry people about how they got started and what a music career actually takes."
  image={featured?.data.heroImage}
>
  <div class="wrap">
    {featured && (
      <section class="lead" aria-labelledby="lead-title">
        <article class="lead-main">
          <div class="eyb">{leadLabel} / Interview {pad(featured.data.number)} / {featured.data.role}</div>
          <h1 id="lead-title"><a href={href(featured)}>{featured.data.title}</a></h1>
          {leadImg && (
            <a href={href(featured)} class="lead-photo" tabindex="-1" aria-hidden="true">
              <Image src={leadImg.src} alt={leadImg.alt} widths={[500, 800, 1100, 1400]} sizes="(max-width: 820px) 100vw, 700px" loading="eager" />
            </a>
          )}
          <p class="sub">{featured.data.intro}</p>
          <div class="hero-meta">Recorded {featured.data.date} · <a href={href(featured)}>Read the interview →</a></div>
        </article>

        {rail.length > 0 && (
          <aside class="rail" aria-labelledby="rail-h">
            <h2 class="rail-h" id="rail-h">{railLabel}</h2>
            <ol class="rail-list">
              {rail.map((i) => {
                const t = thumb(i);
                return (
                  <li>
                    <a class="ri" href={href(i)}>
                      <div class="ri-img">
                        {t ? (
                          <Image src={t.src} alt={t.alt} widths={[160, 240]} sizes="96px" />
                        ) : (
                          <span class="ri-blank">{pad(i.data.number)}</span>
                        )}
                      </div>
                      <div class="ri-txt">
                        <div class="ri-meta"><b>{pad(i.data.number)}</b> {i.data.date}</div>
                        <h3>{i.data.title}</h3>
                        <div class="ri-role">{i.data.role}</div>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ol>
            <a class="rail-all" href="/interviews">All {all.length} interviews →</a>
          </aside>
        )}
      </section>
    )}

    {voices.length > 0 && (
      <section class="voices" aria-labelledby="voices-h">
        <h2 class="sec-h" id="voices-h">In their words</h2>
        <div class={`voices-grid n${voices.length}`}>
          {voices.map((i, idx) => (
            <a class={idx === 0 ? 'qcard vq vq-lead' : 'vq'} href={href(i)}>
              <div class="n">{pad(i.data.number)}</div>
              <blockquote>{i.data.pullquote}</blockquote>
              <cite>{i.data.pullquoteBy ?? i.data.title}</cite>
            </a>
          ))}
        </div>
      </section>
    )}

    {more.length > 0 && (
      <section class="more" aria-labelledby="more-h">
        <div class="sec-top">
          <h2 class="sec-h" id="more-h">More interviews</h2>
          <a class="sec-link" href="/interviews">See all →</a>
        </div>
        <div class="more-grid">
          {more.map((i) => {
            const t = thumb(i);
            return (
              <a class={`gcard ${t ? 'has-img' : 'no-img'}`} href={href(i)}>
                {t ? (
                  <div class="gcard-img">
                    <Image src={t.src} alt={t.alt} widths={[300, 500]} sizes="(max-width: 820px) 50vw, 260px" />
                    <span class="gcard-no">{pad(i.data.number)}</span>
                  </div>
                ) : (
                  <div class="gcard-blank">
                    <span class="gcard-no-lg">{pad(i.data.number)}</span>
                  </div>
                )}
                <div class="gcard-body">
                  <div class="gcard-role">{i.data.role}</div>
                  <h3>{i.data.title}</h3>
                  <div class="gcard-date">{i.data.date}</div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="arch" aria-labelledby="arch-h">
      <h2 class="arch-h" id="arch-h">{archive.length > 0 ? `The archive / ${archive.length} more` : 'The archive'}</h2>
      {archive.map((i) => (
        <a class="row" href={href(i)}>
          <div class="num">{pad(i.data.number)}</div>
          <div class="ti">{i.data.title}</div>
          <div class="rl">{i.data.role}</div>
        </a>
      ))}
      <a class="row next" href="/interviews">
        <div class="num">→</div>
        <div class="ti">Browse every interview</div>
        <div class="rl">{all.length} {all.length === 1 ? 'interview' : 'interviews'}</div>
      </a>
      <a class="row next" href="/contact">
        <div class="num">→</div>
        <div class="ti">Know someone worth interviewing?</div>
        <div class="rl">Get in touch</div>
      </a>
    </section>
  </div>
</Base>

<style>
  /* ---------- Lead story + rail ---------- */
  .lead{
    display:grid;
    grid-template-columns:minmax(0,1fr) 340px;
    gap:48px;
    padding:48px 0 52px;
    border-bottom:2px solid var(--ink);
    align-items:start;
  }
  .lead-main .eyb{margin-bottom:16px}
  .lead-main h1{
    font-family:'Archivo Expanded','Archivo',sans-serif;
    font-weight:800;
    font-size:clamp(30px,4.2vw,46px);
    line-height:1.03;
    letter-spacing:-.02em;
    margin-bottom:26px;
    max-width:24ch;
  }
  .lead-main h1 a:hover{color:var(--blue)}
  .lead-photo{display:block;margin-bottom:24px}
  .lead-photo :global(img){
    width:100%;height:auto;display:block;border-radius:2px;
    aspect-ratio:16/10;object-fit:cover;
  }
  .lead-photo:hover{opacity:.94}
  .lead-main .sub{max-width:600px}
  .lead-main .hero-meta{margin-top:22px;text-transform:uppercase}

  .rail{border-left:1px solid var(--line);padding-left:28px}
  .rail-h{
    font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:12px;
    letter-spacing:.1em;text-transform:uppercase;color:var(--blue);
    padding-bottom:14px;border-bottom:2px solid var(--ink);
  }
  .rail-list{list-style:none}
  .rail-list li + li .ri{border-top:1px solid var(--line)}
  .ri{display:grid;grid-template-columns:96px minmax(0,1fr);gap:16px;padding:20px 0;align-items:start}
  .ri-img{position:relative;aspect-ratio:3/4;overflow:hidden;border-radius:2px;background:#EEE}
  .ri-img :global(img){width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease}
  .ri:hover .ri-img :global(img){transform:scale(1.04)}
  .ri-blank{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    border:2px solid var(--ink);background:var(--paper);border-radius:2px;
    font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:900;font-size:24px;color:var(--blue);
  }
  .ri-meta{
    font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.08em;
    text-transform:uppercase;color:var(--mut);margin-bottom:6px;
  }
  .ri-meta b{
    font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:900;font-size:13px;
    color:var(--blue);letter-spacing:.02em;margin-right:6px;
  }
  .ri h3{
    font-family:'Archivo',sans-serif;font-weight:700;font-size:17px;line-height:1.18;
    letter-spacing:-.005em;color:var(--ink);
  }
  .ri:hover h3{color:var(--blue)}
  .ri-role{
    margin-top:8px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;
    letter-spacing:.06em;text-transform:uppercase;color:var(--mut);line-height:1.45;
    overflow-wrap:anywhere;
  }
  .rail-all{
    display:inline-block;margin-top:6px;
    font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.06em;text-transform:uppercase;
    border-bottom:1px solid var(--blue);padding-bottom:2px;
  }
  .rail-all:hover{color:var(--blue)}

  /* ---------- Shared section headings ---------- */
  .sec-top{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:24px}
  .sec-h{
    font-family:'Archivo',sans-serif;font-weight:700;font-size:12px;
    letter-spacing:.14em;text-transform:uppercase;color:var(--mut);
  }
  .voices .sec-h{margin-bottom:24px}
  .sec-link{
    font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.06em;text-transform:uppercase;
    border-bottom:1px solid var(--blue);padding-bottom:2px;white-space:nowrap;
  }
  .sec-link:hover{color:var(--blue)}

  /* ---------- Pull quotes ---------- */
  .voices{padding:44px 0 52px;border-bottom:1px solid var(--line)}
  .voices-grid{display:grid;gap:24px;align-items:stretch}
  .voices-grid.n1{grid-template-columns:minmax(0,1fr)}
  .voices-grid.n2{grid-template-columns:repeat(2,minmax(0,1fr))}
  .voices-grid.n3{grid-template-columns:1.25fr 1fr 1fr}
  .vq{display:flex;flex-direction:column;padding:26px 0 0;border-top:3px solid var(--blue)}
  .vq .n{
    font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:900;font-size:15px;color:var(--blue);
  }
  .vq blockquote{
    font-family:'Archivo',sans-serif;font-weight:700;font-size:20px;line-height:1.26;
    margin:12px 0 16px;color:var(--ink);
  }
  .vq cite{
    margin-top:auto;font-family:'IBM Plex Mono',monospace;font-style:normal;font-size:11px;
    letter-spacing:.08em;text-transform:uppercase;color:var(--mut);
  }
  .vq:hover blockquote{color:var(--blue)}
  /* The lead quote reuses the global blue .qcard look. */
  .vq.vq-lead{padding:30px 26px;border-top:0;color:#fff}
  .vq.vq-lead .n{color:#fff;opacity:.7}
  .vq.vq-lead blockquote{color:#fff;font-size:23px;line-height:1.24}
  .vq.vq-lead cite{color:#fff;opacity:.85}
  .vq.vq-lead:hover{background:#142CA8}
  .vq.vq-lead:hover blockquote{color:#fff}

  /* ---------- Photo card row ---------- */
  .more{padding:44px 0 56px;border-bottom:2px solid var(--ink)}
  .more-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:34px 24px}
  .more-grid .gcard-body h3{font-size:17px;line-height:1.18}
  .more-grid .gcard-role{font-size:10.5px;line-height:1.45;margin-bottom:6px}
  .gcard-date{
    margin-top:8px;font-family:'IBM Plex Mono',monospace;font-size:11px;
    letter-spacing:.06em;text-transform:uppercase;color:var(--mut);
  }

  /* ---------- Archive rows ---------- */
  .arch{padding-top:34px}
  .arch .row{color:var(--ink)}

  /* ---------- Responsive ---------- */
  @media (max-width:1000px){
    .lead{grid-template-columns:minmax(0,1fr) 300px;gap:36px}
    .ri{grid-template-columns:80px minmax(0,1fr);gap:14px}
  }

  @media (max-width:820px){
    .lead{grid-template-columns:minmax(0,1fr);gap:36px;padding:36px 0 40px}
    .lead-main .sub{font-size:17px}
    .rail{border-left:0;padding-left:0}
    .ri{grid-template-columns:84px minmax(0,1fr)}

    .voices{padding:36px 0 40px}
    .voices-grid.n2,
    .voices-grid.n3{grid-template-columns:minmax(0,1fr);gap:28px}
    .vq.vq-lead blockquote{font-size:21px}
    .vq blockquote{font-size:19px}

    .more{padding:36px 0 44px}
    .more-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 16px}
  }

  @media (max-width:520px){
    .lead-main h1{font-size:30px}
    .ri{grid-template-columns:72px minmax(0,1fr);gap:14px;padding:16px 0}
    .ri h3{font-size:16px}
    .more-grid .gcard-body h3{font-size:15px}
    .more-grid .gcard-body{padding-top:10px}
    .gcard-date{font-size:10px}
  }
</style>
