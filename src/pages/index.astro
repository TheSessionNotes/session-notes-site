---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const all = (await getCollection('interviews')).sort((a, b) => b.data.number - a.data.number);
const lead = all.find((interview) => interview.data.featured) ?? all[0];
const opening = lead ? [lead, ...all.filter((interview) => interview.id !== lead.id).slice(0, 2)] : [];
const pad = (number: number) => String(number).padStart(2, '0');
---
<Base
  title="The Session Notes: interviews with the people who make music work"
  current="home"
  description="An interview publication about the working music world. Conversations with artists, drummers, guitarists, engineers, and industry people about how they got started and what a music career actually takes."
  image={lead?.data.heroImage ?? lead?.data.cardImage}
>
  <main class="wrap homepage">
    <section class="opening" aria-labelledby="latest-heading">
      <div class="section-heading">
        <h1 id="latest-heading">Latest interviews</h1>
        <a class="text-link" href="#archive">The archive <span aria-hidden="true">↘</span></a>
      </div>
      <div class:list={['stories', { 'single-story': opening.length === 1 }]}>
        {opening.map((interview, index) => {
          const data = interview.data;
          const isLead = index === 0;
          const photo = isLead ? (data.heroImage ?? data.cardImage) : (data.cardImage ?? data.heroImage);
          const photoAlt = isLead
            ? (data.heroImage ? data.heroAlt : data.cardAlt)
            : (data.cardImage ? data.cardAlt : data.heroAlt);
          return (
            <article class:list={['story', { 'lead-story': isLead }]}>
              <a class="story-link" href={`/interviews/${interview.id}`}>
                <div class="photo">
                  {photo ? (
                    <Image
                      src={photo}
                      alt={photoAlt ?? data.title}
                      widths={[320, 480, 720, 1080]}
                      sizes={isLead ? '(max-width: 820px) calc(100vw - 68px), (max-width: 1120px) 46vw, 500px' : '(max-width: 820px) calc(100vw - 68px), (max-width: 1120px) 23vw, 250px'}
                      loading={isLead ? 'eager' : 'lazy'}
                      fetchpriority={isLead ? 'high' : 'auto'}
                    />
                  ) : (
                    <span class="photo-fallback" aria-hidden="true">{pad(data.number)}</span>
                  )}
                  <span class="issue">{pad(data.number)}</span>
                </div>
                <div class="story-label">
                  <span>{isLead ? (data.featured ? 'Featured' : 'Latest') : 'Also featured'}</span>
                  <span>{data.date}</span>
                </div>
                <h2>{data.title}</h2>
                <p class="role">{data.role}</p>
                <p class="intro">{data.intro}</p>
                <span class="read">Read the interview <span aria-hidden="true">↗</span></span>
              </a>
            </article>
          );
        })}
      </div>
    </section>

    {lead?.data.pullquote && (
      <figure class="quote-band">
        <div class="quote-label">Interview {pad(lead.data.number)}</div>
        <div>
          <blockquote>{lead.data.pullquote}</blockquote>
          {lead.data.pullquoteBy && <figcaption>{lead.data.pullquoteBy}</figcaption>}
        </div>
      </figure>
    )}

    <section class="archive" id="archive" aria-labelledby="archive-heading">
      <div class="section-heading">
        <h2 id="archive-heading">The archive <span class="count">/ {all.length}</span></h2>
        <a class="text-link" href="/interviews">All interviews <span aria-hidden="true">↗</span></a>
      </div>
      <ol class="archive-list">
        {all.map(({ id, data }) => (
          <li>
            <a class="archive-link" href={`/interviews/${id}`}>
              <span class="archive-number">{pad(data.number)}</span>
              <span class="archive-title">{data.title}</span>
              <span class="archive-role">{data.role}</span>
              <span class="archive-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>

<style>
  .homepage { padding-top: 30px; padding-bottom: 64px; }
  .homepage a:focus-visible { outline: 3px solid var(--blue); outline-offset: 6px; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 17px; border-bottom: 2px solid var(--ink); }
  .section-heading h1, .section-heading h2 { font: 600 12px/1.5 'IBM Plex Mono', monospace; letter-spacing: .09em; text-transform: uppercase; }
  .text-link { font: 500 11px/1.5 'IBM Plex Mono', monospace; color: var(--blue); }
  .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .text-link span { margin-left: 6px; }
  .stories { display: grid; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  .stories.single-story { grid-template-columns: minmax(0, 720px); }
  .story { min-width: 0; }
  .story + .story { border-left: 1px solid var(--line); padding-left: 24px; }
  .story-link { display: block; }
  .photo { position: relative; aspect-ratio: 4/5; background: var(--line); overflow: hidden; }
  .lead-story .photo { aspect-ratio: 16/10; }
  .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .photo-fallback { display: grid; height: 100%; place-items: center; color: var(--blue); font: 900 clamp(48px, 7vw, 100px)/1 'Archivo Expanded', sans-serif; }
  .issue { position: absolute; bottom: 0; left: 0; background: var(--blue); color: var(--paper); padding: 7px 11px; font: 800 15px/1.2 'Archivo Expanded', sans-serif; }
  .story-label { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; margin: 16px 0 10px; font: 500 10px/1.5 'IBM Plex Mono', monospace; letter-spacing: .04em; text-transform: uppercase; color: var(--mut); }
  .story-label span:first-child { color: var(--blue); }
  .story h2 { font: 800 23px/1.12 'Archivo', sans-serif; letter-spacing: -.025em; overflow-wrap: anywhere; }
  .lead-story h2 { font: 800 clamp(28px, 3.1vw, 39px)/1.06 'Archivo Expanded', 'Archivo', sans-serif; letter-spacing: -.035em; }
  .story-link:hover h2 { color: var(--blue); }
  .role { margin-top: 12px; font: 400 10px/1.6 'IBM Plex Mono', monospace; letter-spacing: .035em; text-transform: uppercase; color: var(--soft); overflow-wrap: anywhere; }
  .intro { margin-top: 12px; color: var(--soft); font-size: 14px; line-height: 1.6; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
  .lead-story .intro { font-size: 16px; }
  .read { display: inline-block; margin-top: 18px; padding-bottom: 4px; border-bottom: 1px solid var(--blue); font: 500 10px/1.5 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: .03em; }
  .read span { margin-left: 6px; }
  .quote-band { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 28px; margin: 40px 0; padding: 28px; color: var(--paper); background: var(--blue); }
  .quote-label { font: 500 11px/1.6 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: .06em; }
  .quote-band blockquote { font: 700 clamp(22px, 2.6vw, 30px)/1.2 'Archivo', sans-serif; overflow-wrap: anywhere; }
  .quote-band figcaption { margin-top: 14px; font: 400 10px/1.5 'IBM Plex Mono', monospace; letter-spacing: .06em; text-transform: uppercase; }
  .archive { margin-top: 40px; scroll-margin-top: 24px; }
  .count { color: var(--mut); margin-left: 8px; }
  .archive-list { list-style: none; }
  .archive-link { display: grid; grid-template-columns: 42px minmax(0, 1fr) minmax(0, 190px) 20px; gap: 20px; align-items: start; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .archive-number { color: var(--blue); font: 800 18px/1.3 'Archivo Expanded', sans-serif; }
  .archive-title { font: 700 20px/1.25 'Archivo', sans-serif; overflow-wrap: anywhere; }
  .archive-role { color: var(--soft); font: 400 10px/1.6 'IBM Plex Mono', monospace; text-transform: uppercase; overflow-wrap: anywhere; }
  .archive-arrow { color: var(--blue); }
  .archive-link:hover .archive-title { color: var(--blue); }
  @media (max-width: 820px) {
    .stories { grid-template-columns: minmax(0, 1fr); gap: 30px; }
    .story + .story { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); padding-top: 24px; }
    .photo, .lead-story .photo { aspect-ratio: 16/10; }
    .story h2 { font-size: 27px; }
    .lead-story h2 { font-size: clamp(27px, 5.4vw, 39px); }
    .quote-band { grid-template-columns: minmax(0, 1fr); gap: 14px; padding: 24px; }
    .archive-link { grid-template-columns: 34px minmax(0, 1fr) 16px; gap: 8px 12px; }
    .archive-title { font-size: 19px; }
    .archive-role { grid-column: 2; }
    .archive-arrow { grid-column: 3; grid-row: 1; }
  }
  @media (max-width: 380px) {
    .section-heading { flex-wrap: wrap; gap: 8px; }
  }
</style>
