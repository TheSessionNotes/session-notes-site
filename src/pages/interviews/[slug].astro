---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('interviews');
  return all.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.title} — The Session Notes`}>
  <div class="wrap">
    <article class="article">
      <div class="kicker">Interview No. {String(d.number).padStart(2,'0')} · {d.role}</div>
      <h1>{d.title}</h1>
      <div class="meta">{d.date} · Conversation edited for length and clarity</div>
      <p class="intro">{d.intro}</p>
      <div class="prose">
        <Content />
      </div>
      <a class="back" href="/">← Back to all interviews</a>
    </article>
  </div>
</Base>
